import re
with open("week8/main.cpp", "r") as f:
    text = f.read()

# We need to compute tensor sizes BEFORE optimizing in stages 2 and 3 and keep those sizes.
old_memset = 'std::memset(opt_args[out_idx], 0, get_tensor_size(prog_opt, "out"));'
new_memset = 'std::memset(opt_args[out_idx], 0, get_tensor_size(prog_base, "out"));'

text = text.replace(old_memset, new_memset)

old_verify = 'bool correct = verify_tensors(base_args[out_idx], opt_args[out_idx], get_tensor_size(prog_opt, "out"));'
new_verify = 'bool correct = verify_tensors(base_args[out_idx], opt_args[out_idx], get_tensor_size(prog_base, "out"));'

