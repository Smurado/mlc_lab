// Kleines GEMM fuer die Testreferenz: M = N = K = 32, jeweils in 2 x 16 zerlegt.
// Die inneren Achsen sind 16 gross, damit der SME-Kernel greift (Bedingung:
// mExt % 16 == 0 && nExt % 16 == 0). Alle Tensoren sind zeilenweise abgelegt:
//   out[m][n] = out[m*32 + n]   in0[m][k] = in0[m*32 + k]   in1[k][n] = in1[k*32 + n]
// Strides in BYTES, also Elementabstand * 4.
teir @test_matmul {
  tensor %in0 : f32
  tensor %in1 : f32
  tensor %out : f32

  axis @m0 extent 2  strides { in0: 2048, out: 2048 }
  axis @m1 extent 16 strides { in0: 128,  out: 128  }
  axis @n0 extent 2  strides { in1: 64,   out: 64   }
  axis @n1 extent 16 strides { in1: 4,    out: 4    }
  axis @k0 extent 2  strides { in0: 64,   in1: 2048 }
  axis @k1 extent 16 strides { in0: 4,    in1: 128  }

  primitive @zero : Zero        axes { M: [@m1], N: [@n1]           } metadata { data_type: f32 }
  primitive @gemm : Contraction axes { M: [@m1], N: [@n1], K: [@k1] } metadata { data_type: f32 }

  schedule {
    roots [@iter_k0]

    iter @iter_k0 axis @k0 policy sequential children [@inv_zero, @iter_m0]
    iter @iter_m0 axis @m0 policy sequential children [@iter_n0]
    iter @iter_n0 axis @n0 policy sequential children [@inv_gemm]
    invoke @inv_zero primitive @zero  guard first(@k0)
    invoke @inv_gemm primitive @gemm
  }
}
