teir @matmul_small {
  tensor %in0 : f32
  tensor %in1 : f32
  tensor %out : f32

  axis @m extent 64 strides { in0: 256, out: 256 }
  axis @n extent 64 strides { in1: 4,   out: 4   }
  axis @k extent 64 strides { in0: 4,   in1: 256 }

  primitive @zero : Zero        axes { M: [@m], N: [@n]          } metadata { data_type: f32 }
  primitive @gemm : Contraction axes { M: [@m], N: [@n], K: [@k] } metadata { data_type: f32 }

  schedule {
    roots [@inv_zero, @inv_gemm]
    invoke @inv_zero primitive @zero
    invoke @inv_gemm primitive @gemm
  }
}
