teir @contraction {
  tensor %in0 : f32
  tensor %in1 : f32
  tensor %out : f32
  axis @p extent 512
  axis @q extent 512
  axis @r extent 512
  axis @s extent 64
  axis @t extent 512
  axis @u extent 256
  primitive @zero
  primitive @gemm
  schedule {
    iter @p policy parallel
    iter @r policy parallel
    iter @t policy sequential
    invoke @zero
    invoke @gemm
  }
}
